# ============================================================
# 法信通 LawTrust 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）
# ============================================================

# 阿里云百炼 API Key（控制台：阿里云百炼 → API-KEY 管理 → 创建 API Key）
# 开通百炼时各模型赠送 100 万 token 免费额度（90 天有效）
DASHSCOPE_API_KEY=sk-请填入你的APIKey

# LLM provider："api" = 百炼 API（默认）| "local" = 本地 Qwen2.5-7B（需 GPU）
# LLM_PROVIDER=api

# 可选：覆盖默认模型（默认 qwen3.7-plus；免费额度用尽可切 qwen3.6-plus-2026-04-02，额度独立）
# API_MODEL=qwen3.7-plus

# 可选：全局默认模型（Auto 选项跟随它；前端设置面板会覆盖此值）。
# 可用模型：qwen3.7-plus / qwen-turbo / qwen3.7-max / deepseek-v4-flash-0731 /
#           deepseek-v4-pro / kimi-k2.6 / glm-5.2（均托管于阿里云百炼，共用上方 Key）
# DEFAULT_API_MODEL=qwen3.7-plus
